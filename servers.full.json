{
  "mcpServers": {
    "fetch": {
      "command": "mcp-server-fetch",
      "args": [],
      "env": {}
    },
    "memory": {
      "command": "mcp-server-memory",
      "args": [],
      "env": {
        "MEMORY_FILE_PATH": "/data/memory/memory.json"
      }
    },
    "sequential-thinking": {
      "command": "mcp-server-sequential-thinking",
      "args": [],
      "env": {}
    },
    "odoo_readonly": {
      "command": "node",
      "args": ["/opt/mcp/odoo_readonly/src/index.js"],
      "env": {}
    },
    "odoo_n8n": {
      "command": "node",
      "args": ["/opt/mcp/bin/odoo-n8n-stdio.mjs"],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "wordpress-cmp": {
      "command": "node",
      "args": ["/opt/mcp/wordpress/index.js"],
      "env": {}
    },
    "wordpress-fpx": {
      "command": "node",
      "args": ["/opt/mcp/wordpress/index-fpx.js"],
      "env": {}
    },
    "meta-ads": {
      "command": "node",
      "args": ["/opt/mcp/meta-ads/index.js"],
      "env": {}
    },
    "luna-salud": {
      "command": "node",
      "args": ["/opt/mcp/luna-salud/index.js"],
      "env": {}
    },
    "google_tag_manager": {
      "command": "/opt/mcp/pyvenv/bin/python3",
      "args": ["/opt/mcp/gtm/mcp_start.py"],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "GTM_QA_TOOLS": "1"
      }
    },
    "adloop": {
      "command": "/opt/mcp/pyvenv/bin/adloop",
      "args": [],
      "env": {}
    }
  }
}
